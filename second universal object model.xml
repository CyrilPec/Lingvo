<!-- ============================================================
     UNIVERSAL TYPE AND STRUCTURE RELATIONS
     
     IMPORTANT SEMANTIC DISTINCTION

     is-a:
       Type-to-type specialization.
       A child type is a kind/subtype of a parent type.

     instance-of:
       Object-to-type membership.
       A concrete object is an instance of a type.

     contains:
       Structural containment.
       A container/object contains another object.

     part-of:
       Inverse of contains.
       An object is structurally contained in another object.

     composed-of:
       Composition relation.
       An object is constituted from other objects/components.

     member-of:
       Membership in a group or collection.
       Not necessarily physical or structural containment.
     ============================================================ -->


<!-- ============================================================
     TYPE SYSTEM
     ============================================================ -->

<type-system>

    <!-- --------------------------------------------------------
         IS-A
         --------------------------------------------------------
         TYPE → TYPE

         Example:
             Force is-a PhysicalQuantity
             PhysicalQuantity is-a Object

         NOT:
             force-1 is-a Force

         For an individual object use instance-of.
         -------------------------------------------------------- -->

    <relation
        id="is-a"
        category="type-specialization"
        domain="type"
        range="type"
        inverse="has-subtype">

        <name>is-a</name>

        <description>
            A type is a specialization or subtype of another type.
            The child type inherits the applicable definition,
            properties, relations and constraints of the parent type.
        </description>

        <example>
            Force is-a PhysicalQuantity.
        </example>

        <inverse>
            has-subtype
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         INSTANCE-OF
         --------------------------------------------------------
         OBJECT → TYPE

         Example:
             force-1 instance-of Force

         This is membership/typing, not inheritance.
         -------------------------------------------------------- -->

    <relation
        id="instance-of"
        category="typing"
        domain="object"
        range="type"
        inverse="has-instance">

        <name>instance-of</name>

        <description>
            A concrete object is an instance of a defined type.
            Instance-of does not create inheritance between types.
        </description>

        <example>
            force-1 instance-of Force.
        </example>

        <inverse>
            has-instance
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         VARIANT-OF
         -------------------------------------------------------- -->

    <relation
        id="variant-of"
        category="specialization"
        domain="object"
        range="object"
        inverse="has-variant">

        <name>variant-of</name>

        <description>
            An object or type is a variation of another object or type
            while retaining a recognizable identity or structure.
        </description>

        <inverse>
            has-variant
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         HAS-SUBTYPE
         -------------------------------------------------------- -->

    <relation
        id="has-subtype"
        category="type-specialization"
        domain="type"
        range="type"
        inverse="is-a">

        <description>
            A type has another type as one of its specializations.
        </description>

    </relation>


    <!-- --------------------------------------------------------
         HAS-INSTANCE
         -------------------------------------------------------- -->

    <relation
        id="has-instance"
        category="typing"
        domain="type"
        range="object"
        inverse="instance-of">

        <description>
            A type has a concrete object as an instance.
        </description>

    </relation>

</type-system>


<!-- ============================================================
     STRUCTURAL RELATIONS
     ============================================================ -->

<structure>

    <!-- --------------------------------------------------------
         CONTAINS
         --------------------------------------------------------
         CONTAINER/OBJECT → OBJECT

         Example:
             Human contains Brain
             Document contains Section
             MechanicalSystem contains Component

         Contains describes structural inclusion.
         -------------------------------------------------------- -->

    <relation
        id="contains"
        category="structural-containment"
        domain="object"
        range="object"
        inverse="part-of">

        <name>contains</name>

        <description>
            An object structurally contains another object.
            Containment describes composition or inclusion and does
            not imply type inheritance or instance membership.
        </description>

        <inverse>
            part-of
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         PART-OF
         -------------------------------------------------------- -->

    <relation
        id="part-of"
        category="structural-containment"
        domain="object"
        range="object"
        inverse="contains">

        <name>part-of</name>

        <description>
            An object is structurally contained within another object.
        </description>

        <inverse>
            contains
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         COMPOSED-OF
         --------------------------------------------------------
         Example:
             Car composed-of Engine, Wheels, Body
         -------------------------------------------------------- -->

    <relation
        id="composed-of"
        category="composition"
        domain="object"
        range="object"
        inverse="component-of">

        <name>composed-of</name>

        <description>
            An object is constituted from other objects or components.
            Composition expresses constitutive structure and is stronger
            than generic relation.
        </description>

        <inverse>
            component-of
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         COMPONENT-OF
         -------------------------------------------------------- -->

    <relation
        id="component-of"
        category="composition"
        domain="object"
        range="object"
        inverse="composed-of">

        <description>
            An object functions as a constitutive component of another
            object.
        </description>

        <inverse>
            composed-of
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         MEMBER-OF
         --------------------------------------------------------
         Membership is deliberately different from containment.

         Example:
             neuron member-of neural-network
             country member-of organization
             word member-of vocabulary
         
         A member need not be a structural physical part.
         -------------------------------------------------------- -->

    <relation
        id="member-of"
        category="membership"
        domain="object"
        range="object"
        inverse="has-member">

        <name>member-of</name>

        <description>
            An object belongs to a group, collection, class or system.
            Membership does not necessarily imply structural containment.
        </description>

        <inverse>
            has-member
        </inverse>

    </relation>


    <!-- --------------------------------------------------------
         HAS-MEMBER
         -------------------------------------------------------- -->

    <relation
        id="has-member"
        category="membership"
        domain="object"
        range="object"
        inverse="member-of">

        <description>
            An object or group has another object as a member.
        </description>

        <inverse>
            member-of
        </inverse>

    </relation>

</structure>
