        </relation>
      </relations>

      <dimensions>
        <dimension ref="semantic"/>
        <dimension ref="pragmatic-discourse"/>
        <dimension ref="narrative-dramatic"/>
        <dimension ref="rhetorical-poetic-stylistic"/>
