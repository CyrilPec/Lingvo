        </relation>

        <relation type="contains">
          <target ref="word"/>
        </relation>

        <relation type="depends-on">
          <target ref="section"/>
        </relation>
      </relations>

      <dimensions>
        <dimension ref="structural"/>
        <dimension ref="semantic"/>
        <dimension ref="pragmatic-discourse"/>
        <dimension ref="prosodic-intonational"/>
