  <!-- ============================================================
       INHERITANCE
       ONLY "IS-A" RELATIONSHIPS ARE DEFINED HERE.
       Notice what is NOT here:
           word -> syllable
           syllable -> sound
           phrase -> utterance
       Those are composition relationships and are defined below.
       ============================================================ -->
  <inheritance>
    <!-- Universal -->
    <is-a child="container" parent="object"/>
    <is-a child="linguistic-object" parent="object"/>
    <is-a child="signal-object" parent="object"/>
    <is-a child="dimension" parent="object"/>
    <is-a child="aspect" parent="object"/>
    <is-a child="system" parent="object"/>
    <!-- Structural -->
    <is-a child="world" parent="container"/>
    <is-a child="dramaturgy" parent="container"/>
    <is-a child="narrative" parent="container"/>
    <is-a child="form" parent="container"/>
    <is-a child="section" parent="container"/>
    <is-a child="phrase" parent="container"/>
    <is-a child="utterance" parent="container"/>
    <!-- Linguistic -->
    <is-a child="word" parent="linguistic-object"/>
    <is-a child="syllable" parent="linguistic-object"/>
    <!-- Signal -->
    <is-a child="sound" parent="signal-object"/>
  </inheritance>
  <!-- ============================================================
       COMPOSITION
       THIS IS WHERE STRUCTURAL NESTING IS DEFINED.
       It means:
           World contains Dramaturgy
           Dramaturgy contains Narrative
           Narrative contains Form
           Form contains Section
           Section contains Phrase
           Phrase contains Utterance
           Utterance contains Word
           Word contains Syllable
           Syllable contains Sound
       NONE OF THESE MEAN "IS-A".
       ============================================================ -->
  <composition>
    <contains
        parent="world"
        child="dramaturgy"/>
    <contains
        parent="dramaturgy"
        child="narrative"/>
    <contains
        parent="narrative"
        child="form"/>
    <contains
        parent="form"
        child="section"/>
    <contains
        parent="section"
        child="phrase"/>
    <contains
        parent="phrase"
        child="utterance"/>
    <contains
        parent="utterance"
        child="word"/>
    <contains
        parent="word"
        child="syllable"/>
    <contains
        parent="syllable"
        child="sound"/>
  </composition>
  <!-- ============================================================
       OBJECT RELATIONS
       Additional relations between objects.
       ============================================================ -->
  <relations>
    <!-- Narrative / structural -->
    <relation
        subject="dramaturgy"
        type="depends-on"
        object="world"/>
    <relation
        subject="narrative"
        type="depends-on"
        object="dramaturgy"/>
    <relation
        subject="form"
        type="depends-on"
        object="narrative"/>
    <relation
        subject="section"
        type="depends-on"
        object="form"/>
    <relation
        subject="phrase"
        type="depends-on"
        object="section"/>
    <relation
        subject="utterance"
        type="depends-on"
        object="phrase"/>
    <relation
        subject="word"
        type="depends-on"
        object="utterance"/>
    <relation
        subject="syllable"
        type="depends-on"
        object="word"/>
    <relation
        subject="sound"
        type="realizes"
        object="syllable"/>
  </relations>
