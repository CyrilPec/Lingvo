<?xml version="1.0" encoding="UTF-8"?>

<lingvo
    xmlns:xi="http://www.w3.org/2001/XInclude"
    id="lingvo"
    name="Lingvo"
    version="2.0">

  <!-- ============================================================
       LINGVO
       Unified Object / Inheritance / Relation Model

       Everything is an object.

       Objects may inherit from other objects.
       Objects may contain other objects.
       Objects may participate in dimensions and systems.
       Dimensions, aspects and systems are objects too.

       The hierarchy is therefore a graph of objects and relations,
       not a separate type of entity.
       ============================================================ -->

  <meta>
    <title>Lingvo Unified Object Model</title>

    <description>
      Language, Sound, Music, Meaning and Structure represented as
      a unified graph of inherited objects, relations, aspects and systems.
    </description>

    <model>
      Object × Inheritance × Relation × Aspect × System
    </model>

    <version-history>
      <previous-model>
        Hierarchy × Level × Object × Dimension
      </previous-model>

      <current-model>
        Object × Inheritance × Relation × Aspect × System
      </current-model>
    </version-history>
  </meta>


  <!-- ============================================================
       PRINCIPLES
       ============================================================ -->

  <principles>

    <principle id="object-model">
      Everything in Lingvo is represented as an object.
    </principle>

    <principle id="unified-model">
      Hierarchy, dimensions, aspects, systems and linguistic entities
      are all represented within the same object model.
    </principle>

    <principle id="inheritance">
      Objects inherit properties, functions, relations, constraints,
      variants, aspects and systems from parent objects.
    </principle>

    <principle id="composition">
      Objects may contain, compose, realize or depend on other objects.
    </principle>

    <principle id="relation">
      Structural and cross-level organization is represented through
      explicit relations between objects.
    </principle>

    <principle id="scale">
      Scale describes the relative structural position of an object.
      Scale is metadata, not a separate ontological entity.
    </principle>

    <principle id="aspect">
      An aspect describes a reusable property-space that may occur
      across multiple objects and scales.
    </principle>

    <principle id="dimension">
      A dimension is an object that groups related aspects.
      Dimensions may be inherited, composed and applied across objects.
    </principle>

    <principle id="system">
      A system is an object representing a coherent process or relation
      operating across multiple objects.
    </principle>

    <principle id="variant">
      Variants specialize an object without requiring a new structural level.
    </principle>

    <principle id="transformation">
      Objects may change state or transform while retaining identity
      and relations.
    </principle>

    <principle id="cross-level">
      Any object may relate to another object regardless of scale.
    </principle>

  </principles>


  <!-- ============================================================
       RELATION TYPES
       ============================================================ -->

  <relation-types>

    <relation-type id="is-a">
      Inheritance / specialization relation.
    </relation-type>

    <relation-type id="contains">
      Object contains another object.
    </relation-type>

    <relation-type id="part-of">
      Object is a structural part of another object.
    </relation-type>

    <relation-type id="composed-of">
      Object is composed of other objects.
    </relation-type>

    <relation-type id="belongs-to">
      Object belongs to another object.
    </relation-type>

    <relation-type id="depends-on">
      Object depends on another object.
    </relation-type>

    <relation-type id="modifies">
      Object modifies another object.
    </relation-type>

    <relation-type id="contrasts-with">
      Object contrasts with another object.
    </relation-type>

    <relation-type id="repeats">
      Object repeats another object or pattern.
    </relation-type>

    <relation-type id="continues">
      Object continues another object.
    </relation-type>

    <relation-type id="responds-to">
      Object responds to another object.
    </relation-type>

    <relation-type id="transforms">
      Object transforms into or transforms another object.
    </relation-type>

    <relation-type id="realizes">
      Object realizes another object, function or structure.
    </relation-type>

    <relation-type id="interacts-with">
      Object interacts with another object.
    </relation-type>

    <relation-type id="before">
      Temporal precedence.
    </relation-type>

    <relation-type id="after">
      Temporal succession.
    </relation-type>

    <relation-type id="simultaneous">
      Temporal simultaneity.
    </relation-type>

    <relation-type id="has-aspect">
      Object participates in an aspect.
    </relation-type>

    <relation-type id="has-dimension">
      Object participates in a dimension.
    </relation-type>

    <relation-type id="member-of">
      Object is a member of a system.
    </relation-type>

  </relation-types>


  <!-- ============================================================
       OBJECT MODEL
       Everything below is an object.
       ============================================================ -->

  <objects>


    <!-- ==========================================================
         ROOT
         ========================================================== -->

    <object
        id="object"
        name="Object"
        kind="root"
        scale="0">

      <description>
        Universal base object from which all Lingvo objects inherit.
      </description>

      <identity>
        <property id="identity"/>
        <property id="state"/>
      </identity>

      <properties>
        <property id="identity"/>
        <property id="state"/>
      </properties>

      <functions>
        <function id="exist"/>
        <function id="change"/>
        <function id="transform"/>
      </functions>

      <relations>
        <relation type="is-a"/>
        <relation type="contains"/>
        <relation type="part-of"/>
        <relation type="composed-of"/>
        <relation type="belongs-to"/>
        <relation type="depends-on"/>
        <relation type="modifies"/>
        <relation type="contrasts-with"/>
        <relation type="repeats"/>
        <relation type="continues"/>
        <relation type="responds-to"/>
        <relation type="transforms"/>
        <relation type="realizes"/>
        <relation type="interacts-with"/>
        <relation type="before"/>
        <relation type="after"/>
        <relation type="simultaneous"/>
        <relation type="has-aspect"/>
        <relation type="has-dimension"/>
        <relation type="member-of"/>
      </relations>

      <constraints/>
      <variants/>
      <aspects/>
      <dimensions/>
      <systems/>

    </object>


    <!-- ==========================================================
         STRUCTURAL OBJECT TYPES
         ========================================================== -->

    <object
        id="container"
        name="Container"
        extends="object"
        kind="structural">

      <description>
        An object that may contain, order and compose other objects.
      </description>

      <functions>
        <function id="group"/>
        <function id="order"/>
        <function id="compose"/>
      </functions>

      <relations>
        <relation type="contains"/>
        <relation type="composed-of"/>
      </relations>

    </object>


    <object
        id="dimension"
        name="Dimension"
        extends="object"
        kind="dimension">

      <description>
        A reusable aspect-space operating across objects and scales.
      </description>

      <functions>
        <function id="organize-aspects"/>
        <function id="apply"/>
        <function id="inherit"/>
      </functions>

      <relations>
        <relation type="contains"/>
        <relation type="has-aspect"/>
        <relation type="has-dimension"/>
      </relations>

    </object>


    <object
        id="aspect"
        name="Aspect"
        extends="object"
        kind="aspect">

      <description>
        A reusable characteristic, property-space or analytical aspect.
      </description>

      <relations>
        <relation type="belongs-to"/>
        <relation type="has-dimension"/>
      </relations>

    </object>


    <object
        id="system"
        name="System"
        extends="object"
        kind="system">

      <description>
        A coherent process, organization or cross-object system.
      </description>

      <functions>
        <function id="operate"/>
        <function id="coordinate"/>
        <function id="transform"/>
      </functions>

      <relations>
        <relation type="contains"/>
        <relation type="member-of"/>
        <relation type="interacts-with"/>
        <relation type="transforms"/>
      </relations>

    </object>


    <!-- ==========================================================
         WORLD
         Scale 0
         ========================================================== -->

    <object
        id="world"
        name="World"
        extends="container"
        scale="0">

      <description>
        Environment in which linguistic, musical, dramatic and
        perceptual objects exist.
      </description>

      <properties>
        <property id="environment"/>
        <property id="time"/>
        <property id="space"/>
        <property id="rules"/>
        <property id="possibilities"/>
        <property id="values"/>
        <property id="conflicts"/>
      </properties>

      <relations>
        <relation type="contains">
          <target ref="dramaturgy"/>
        </relation>

        <relation type="contains">
          <target ref="narrative"/>
        </relation>

        <relation type="contains">
          <target ref="form"/>
        </relation>
      </relations>

      <dimensions>
        <dimension ref="temporal"/>
        <dimension ref="social-cultural"/>
        <dimension ref="identity-motif"/>
        <dimension ref="expectation"/>
      </dimensions>

    </object>


    <!-- ==========================================================
         DRAMATURGY
         Scale 1
         ========================================================== -->

