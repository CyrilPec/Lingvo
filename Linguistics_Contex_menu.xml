<?xml version="1.0" encoding="UTF-8"?>
<lingvo
    xmlns:xi="http://www.w3.org/2001/XInclude"
    id="lingvo"
    name="Lingvo"
    version="2.0">
  <!-- ============================================================
       LINGVO
       Unified Object Graph
       Fundamental rule:
           Everything is an Object.
       Objects are connected by different kinds of relations.
           is-a            = inheritance / type
           contains       = composition
           part-of        = inverse composition
           has-aspect      = analytical aspect
           participates-in = system participation
           relates-to      = general relation
       IMPORTANT:
           The structural sequence
               Text
                 -> Section
                 -> Phrase
                 -> Utterance
                 -> Word
                 -> Syllable
                 -> Sound
           is NOT an inheritance hierarchy.
       It is a composition hierarchy.
       Inheritance answers:
           "What kind of object is this?"
       Composition answers:
           "What is this object made of / containing?"
       Aspect answers:
           "From which dimension can this object be described?"
       System participation answers:
           "Which cross-object process does this object participate in?"
       ============================================================ -->
  <!-- ============================================================
       META
       ============================================================ -->
  <meta>
    <title>Lingvo Unified Object Graph</title>
    <description>
      Language, Sound, Music, Meaning and Structure represented as
      a unified graph of objects, inheritance, composition,
      aspects, relations and cross-object systems.
    </description>
    <model>
      Object × Inheritance × Composition × Aspect × Relation × System
    </model>
    <version>
      2.0
    </version>
  </meta>
  <!-- ============================================================
       FUNDAMENTAL PRINCIPLES
       ============================================================ -->
  <principles>
    <principle id="object-model">
      Everything in Lingvo is represented as an object.
    </principle>
    <principle id="identity">
      Every object has an identity independent of its current state,
      position, relation or interpretation.
    </principle>
    <principle id="inheritance">
      Inheritance expresses an "is-a" relationship.
      A child object type inherits characteristics from its parent type.
    </principle>
    <principle id="composition">
      Composition expresses a "contains" or "part-of" relationship.
      Composition does not imply inheritance.
    </principle>
    <principle id="aspect">
      An aspect describes an object from a particular analytical dimension.
    </principle>
    <principle id="dimension">
      A dimension is an object that groups related aspects.
      Dimensions may apply to objects at different structural scales.
    </principle>
    <principle id="system">
      A system is an object representing an organized process or
      relation operating across multiple objects.
    </principle>
    <principle id="relation">
      Relations connect objects without requiring inheritance.
    </principle>
    <principle id="scale">
      Scale describes structural granularity.
      Scale does not define inheritance.
    </principle>
    <principle id="variant">
      A variant specializes an object without necessarily creating
      a new structural type or scale.
    </principle>
    <principle id="transformation">
      Objects may change state or transform while retaining identity
      and relations.
    </principle>
    <principle id="cross-scale">
      Objects may relate to other objects at any scale.
    </principle>
  </principles>
  <!-- ============================================================
       RELATION TYPES
       ============================================================ -->
  <relation-types>
    <!-- TYPE / INHERITANCE -->
    <relation-type
        id="is-a"
        category="type">
      Child object type is a specialization of the parent object type.
    </relation-type>
    <!-- COMPOSITION -->
    <relation-type
        id="contains"
        inverse="part-of"
        category="composition">
      Object contains another object.
    </relation-type>
    <relation-type
        id="part-of"
        inverse="contains"
        category="composition">
      Object is a structural part of another object.
    </relation-type>
    <relation-type
        id="composed-of"
        inverse="part-of"
        category="composition">
      Object is composed of other objects.
    </relation-type>
    <!-- ORGANIZATION -->
    <relation-type
        id="belongs-to"
        category="structural">
      Object belongs to another object or context.
    </relation-type>
    <relation-type
        id="depends-on"
        category="dependency">
      Object depends on another object.
    </relation-type>
    <!-- TRANSFORMATION -->
    <relation-type
        id="transforms"
        category="process">
      Object transforms another object or changes into another state.
    </relation-type>
    <relation-type
        id="realizes"
        category="realization">
      Object realizes another object, function or structure.
    </relation-type>
    <!-- INTERACTION -->
    <relation-type
        id="modifies"
        category="interaction">
      Object modifies another object.
    </relation-type>
    <relation-type
        id="contrasts-with"
        category="interaction">
      Objects are structurally or perceptually contrasted.
    </relation-type>
    <relation-type
        id="repeats"
        category="interaction">
      Object repeats another object or pattern.
    </relation-type>
    <relation-type
        id="continues"
        category="interaction">
      Object continues another object or process.
    </relation-type>
    <relation-type
        id="responds-to"
        category="interaction">
      Object responds to another object.
    </relation-type>
    <relation-type
        id="interacts-with"
        category="interaction">
      General interaction between objects.
    </relation-type>
    <!-- TEMPORAL -->
    <relation-type
        id="before"
        category="temporal">
      Object precedes another object.
    </relation-type>
    <relation-type
        id="after"
        category="temporal">
      Object follows another object.
    </relation-type>
    <relation-type
        id="simultaneous"
        category="temporal">
      Objects occur simultaneously.
    </relation-type>
    <!-- ASPECT -->
    <relation-type
        id="has-aspect"
        category="analytical">
      Object participates in an aspect.
    </relation-type>
    <relation-type
        id="has-dimension"
        category="analytical">
      Object participates in a dimension.
    </relation-type>
    <!-- SYSTEM -->
    <relation-type
        id="participates-in"
        category="system">
      Object participates in a cross-object system.
    </relation-type>
    <relation-type
        id="member-of"
        category="system">
      Object is a member of a system.
    </relation-type>
  </relation-types>
  <!-- ============================================================
       OBJECT TYPE DEFINITIONS
       These are TYPES, not individual linguistic occurrences.
       Every type ultimately inherits from Object.
       ============================================================ -->
  <types>
    <!-- ==========================================================
         UNIVERSAL OBJECT
         ========================================================== -->
    <type
        id="object"
        name="Object">
      <description>
        Universal object type from which every Lingvo object inherits.
      </description>
      <properties>
        <property id="identity"/>
        <property id="state"/>
        <property id="existence"/>
      </properties>
      <functions>
        <function id="exist"/>
        <function id="change"/>
        <function id="transform"/>
      </functions>
      <relations>
        <relation type="is-a"/>
        <relation type="contains"/>
        <relation type="part-of"/>
        <relation type="belongs-to"/>
        <relation type="depends-on"/>
        <relation type="modifies"/>
        <relation type="contrasts-with"/>
        <relation type="repeats"/>
        <relation type="continues"/>
        <relation type="responds-to"/>
        <relation type="transforms"/>
        <relation type="realizes"/>
        <relation type="interacts-with"/>
        <relation type="before"/>
        <relation type="after"/>
        <relation type="simultaneous"/>
        <relation type="has-aspect"/>
        <relation type="has-dimension"/>
        <relation type="participates-in"/>
      </relations>
    </type>
    <!-- ==========================================================
         CONTAINER
         ========================================================== -->
    <type
        id="container"
        name="Container"
        extends="object">
      <description>
        An object capable of containing or composing other objects.
      </description>
      <functions>
        <function id="group"/>
        <function id="order"/>
        <function id="compose"/>
      </functions>
      <relations>
        <relation type="contains"/>
        <relation type="composed-of"/>
      </relations>
    </type>
    <!-- ==========================================================
         LINGUISTIC OBJECT
         ========================================================== -->
    <type
        id="linguistic-object"
        name="Linguistic Object"
        extends="object">
      <description>
        Object participating in linguistic structure or meaning.
      </description>
    </type>
    <!-- ==========================================================
         PERCEPTUAL / ACOUSTIC OBJECT
         ========================================================== -->
    <type
        id="signal-object"
        name="Signal Object"
        extends="object">
      <description>
        Object representing an acoustic, perceptual or signal-level entity.
      </description>
    </type>
    <!-- ==========================================================
         DIMENSION
         ========================================================== -->
    <type
        id="dimension"
        name="Dimension"
        extends="object">
      <description>
        Analytical dimension containing reusable aspects.
      </description>
      <relations>
        <relation type="contains"/>
        <relation type="has-aspect"/>
      </relations>
    </type>
    <!-- ==========================================================
         ASPECT
         ========================================================== -->
    <type
        id="aspect"
        name="Aspect"
        extends="object">
      <description>
        Reusable analytical characteristic of an object.
      </description>
    </type>
    <!-- ==========================================================
         SYSTEM
         ========================================================== -->
    <type
        id="system"
        name="System"
        extends="object">
      <description>
        Cross-object process, organization or relational system.
      </description>
      <functions>
        <function id="operate"/>
        <function id="coordinate"/>
        <function id="transform"/>
      </functions>
    </type>
