        <property id="goal"/>
        <property id="motivation"/>
        <property id="obstacle"/>
        <property id="consequence"/>
        <property id="tension"/>
        <property id="turning-point"/>
        <property id="climax"/>
        <property id="resolution"/>
      </properties>

      <relations>
        <relation type="contains">
          <target ref="narrative"/>
        </relation>

        <relation type="depends-on">
          <target ref="world"/>
        </relation>
      </relations>

      <dimensions>
        <dimension ref="narrative-dramatic"/>
        <dimension ref="expectation"/>
        <dimension ref="temporal"/>
        <dimension ref="information-dynamics"/>
        <dimension ref="attention-salience"/>
